# ==========================================
# TravelWise AI Service Environment Configuration
# ==========================================

# Option 1: Multiple Gemini API Keys (Instant automatic failover on rate limit / 429 / quota limit)
# Provide up to 10 (or more) keys as separate numbered keys or comma-separated list:
GEMINI_API_KEY_1=replace-with-gemini-key-1
GEMINI_API_KEY_2=replace-with-gemini-key-2
GEMINI_API_KEY_3=replace-with-gemini-key-3
GEMINI_API_KEY_4=replace-with-gemini-key-4
GEMINI_API_KEY_5=replace-with-gemini-key-5
GEMINI_API_KEY_6=replace-with-gemini-key-6
GEMINI_API_KEY_7=replace-with-gemini-key-7
GEMINI_API_KEY_8=replace-with-gemini-key-8
GEMINI_API_KEY_9=replace-with-gemini-key-9
GEMINI_API_KEY_10=replace-with-gemini-key-10

# Or comma-separated list:
# GEMINI_API_KEYS=key1,key2,key3,key4,key5,key6,key7,key8,key9,key10

# Backward-compatible single key (optional):
# GEMINI_API_KEY=replace-with-your-google-ai-studio-key

# Gemini Models:
# - gemini-3.1-flash-lite (Recommended: High speed, low token usage, ideal for multi-agent loops)
# - gemini-2.5-flash      (Balanced speed & intelligence)
# - gemini-2.5-flash-lite (Cost-effective fast flash)
# - gemini-2.0-flash      (Stable generation)
# - gemini-2.5-pro        (Deep reasoning)
GEMINI_MODEL=gemini-3.1-flash-lite

# Fail-safe behavior (false = gracefully degrade to deterministic plan if all keys exhausted)
AI_REQUIRE_GEMINI=false

# Internal security key
AI_INTERNAL_API_KEY=replace-with-a-long-random-service-key
